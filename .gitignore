# Local environment and secrets — constraint C-SECRETS
.env
.env.*
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors and OS
.DS_Store
.idea/
*.swp

# Check results are a fresh, per-run record, not approved state. Regenerate with
# tools/verify.py; never rely on a committed green result.
checks/results.json

# Generated dashboard and its Artifact URL (the /board command). Local, not approved state.
checks/board.html
checks/board-url.txt

# Local agent scratch that should not be committed
.claude/settings.local.json
