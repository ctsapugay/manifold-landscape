# Manifold Landscape — environment configuration TEMPLATE.
#
# This file is SAFE to commit: it holds no real secrets, only placeholders.
# To use the tool: copy this file to `.env` and fill in your real values.
# `.env` is gitignored and must NEVER be committed (constraint C-SECRETS).
#
#     cp .env.example .env      # then edit .env with your key
#
# The AI tutor agent calls the Anthropic (Claude) API. Get a key at
# https://console.anthropic.com/ and paste it below in your local `.env`.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (leave unset to use the app's defaults):
# MANIFOLD_MODEL=claude-...          # which Claude model the agent uses
# MANIFOLD_PORT=8765                 # local server port
